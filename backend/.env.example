# Backend Environment Variables
# Copy this file to .env and fill in your values

# Server
PORT=5000

# MongoDB
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# JWT
JWT_SECRET=your_jwt_secret_here
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here

# CORS - Frontend origins (comma-separated for multiple Vercel deployments)
CLIENT_URL=http://localhost:3000
# CLIENT_URLS=https://your-production-frontend.vercel.app,https://your-preview-frontend.vercel.app

# Email (Gmail SMTP - use an App Password, not your real password)
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password

# Redis (optional - in-memory mock is used if not set)
REDIS_URL=redis://localhost:6379
